# Copia questo file in .env e inserisci i tuoi valori reali.
# .env non viene mai committato su git (vedi .gitignore).

# Client ID OAuth creato su Google Cloud Console > Google Auth Platform > Client
VITE_GOOGLE_CLIENT_ID=

# ID del Google Sheet che funge da database (dalla URL del foglio, tra /d/ e /edit)
VITE_SPREADSHEET_ID=
